'use client';

import { useState, useRef, useEffect } from 'react';
import { TerminalSquare, FileCode2, Play, Activity, FolderGit2, ShieldAlert, Code, Search, Plus, Trash2, Edit3, X, Maximize2, Minimize2, ChevronDown } from 'lucide-react';
import { cn } from '@/lib/utils';
import { api } from '@/lib/api';
import useAuthStore from '@/hooks/useAuth';

interface ScriptTemplate {
  script_id: string;
  name: string;
  content: string;
  interpreter: string;
}

export default function CommandAndControlPage() {
  const [selectedScript, setSelectedScript] = useState<ScriptTemplate | null>(null);
  const [scripts, setScripts] = useState<ScriptTemplate[]>([]);
  const [terminalInput, setTerminalInput] = useState('');
  const [terminalHistory, setTerminalHistory] = useState<{type: 'input' | 'output' | 'system', text: string, isError?: boolean}[]>([
    { type: 'system', text: 'AEGIS OS TERMINAL INITIALIZED.' },
    { type: 'system', text: 'Awaiting connection to remote target...' }
  ]);
  const [isFullscreen, setIsFullscreen] = useState(false);
  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);

  const [newScriptForm, setNewScriptForm] = useState({ name: '', interpreter: 'bash', content: '' });
  const [targetDeviceId, setTargetDeviceId] = useState<string>('00000000-0000-0000-0000-000000000000'); // Default or placeholder

  const terminalEndRef = useRef<HTMLDivElement>(null);
  const wsRef = useRef<WebSocket | null>(null);
  const { accessToken } = useAuthStore();

  useEffect(() => {
    fetchScripts();
  }, []);

  useEffect(() => {
    if (terminalEndRef.current) {
      terminalEndRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [terminalHistory]);

  const fetchScripts = async () => {
    try {
      const { data } = await api.get('/api/v1/scripts');
      setScripts(data || []);
    } catch (err) {
      console.error('Failed to fetch scripts', err);
    }
  };

  const connectWebSocket = (deviceId: string) => {
    if (wsRef.current) {
      wsRef.current.close();
    }

    if (!accessToken) return;

    setTerminalHistory([{ type: 'system', text: `Initiating WebSocket reverse shell to ${deviceId}...` }]);

    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const host = process.env.NEXT_PUBLIC_API_URL?.replace(/^http(s?):\/\//, '') || window.location.host;
    const wsUrl = `${protocol}//${host}/ws/v1/terminal/${deviceId}?token=${accessToken}`;

    const ws = new WebSocket(wsUrl);

    ws.onopen = () => {
      setTerminalHistory(prev => [...prev, { type: 'system', text: `P2P Link ESTABLISHED with ${deviceId}. Shell ready.` }]);
    };

    ws.onmessage = (event) => {
      setTerminalHistory(prev => [...prev, { type: 'output', text: event.data }]);
    };

    ws.onclose = () => {
      setTerminalHistory(prev => [...prev, { type: 'system', text: 'Connection closed.' }]);
    };

    ws.onerror = (err) => {
      setTerminalHistory(prev => [...prev, { type: 'system', text: 'WebSocket connection error.', isError: true }]);
    };

    wsRef.current = ws;
  };

  const handleDeviceChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const newTarget = e.target.value;
    setTargetDeviceId(newTarget);
    connectWebSocket(newTarget);
  };

  const handleCommandSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!terminalInput.trim()) return;

    setTerminalHistory(prev => [...prev, { type: 'input', text: terminalInput }]);

    // Fallback to REST execution if WebSocket is not open or we prefer REST for commands
    if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {
       wsRef.current.send(terminalInput);
    } else {
       // Using the REST endpoint as fallback/alternative
       try {
         const { data } = await api.post('/api/v1/commands/execute', {
           device_id: targetDeviceId,
           payload: terminalInput
         });
         if (data.stdout) {
           setTerminalHistory(prev => [...prev, { type: 'output', text: data.stdout }]);
         }
         if (data.stderr) {
           setTerminalHistory(prev => [...prev, { type: 'output', text: data.stderr, isError: true }]);
         }
       } catch (err: any) {
         if (err.response?.status === 403) {
            setTerminalHistory(prev => [...prev, { type: 'system', text: 'ERROR: 2FA_REQUIRED_FOR_THIS_ACTION or Command Blocked', isError: true }]);
         } else {
            setTerminalHistory(prev => [...prev, { type: 'system', text: 'Execution failed.', isError: true }]);
         }
       }
    }

    setTerminalInput('');
  };

  const handleCreateScript = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      await api.post('/api/v1/scripts', newScriptForm);
      setIsCreateModalOpen(false);
      setNewScriptForm({ name: '', interpreter: 'bash', content: '' });
      fetchScripts();
    } catch (err) {
      console.error('Failed to create script', err);
    }
  };

  const handleDeleteScript = async (id: string, e: React.MouseEvent) => {
    e.stopPropagation();
    try {
      await api.delete(`/api/v1/scripts/${id}`);
      if (selectedScript?.script_id === id) {
        setSelectedScript(null);
      }
      fetchScripts();
    } catch (err) {
      console.error('Failed to delete script', err);
    }
  };

  const handleRunScriptRest = async () => {
    if (!selectedScript) return;
    setTerminalHistory(prev => [...prev, { type: 'system', text: `Executing script ${selectedScript.name} via REST...` }]);
    try {
       const { data } = await api.post('/api/v1/commands/execute', {
         device_id: targetDeviceId,
         payload: selectedScript.content
       });
       if (data.stdout) {
         setTerminalHistory(prev => [...prev, { type: 'output', text: data.stdout }]);
       }
       if (data.stderr) {
         setTerminalHistory(prev => [...prev, { type: 'output', text: data.stderr, isError: true }]);
       }
    } catch (err: any) {
       setTerminalHistory(prev => [...prev, { type: 'system', text: 'Script execution failed.', isError: true }]);
    }
    setSelectedScript(null); // Return to terminal view
  };

  return (
    <div className="relative h-[calc(100vh-6rem)] overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-700 flex flex-col pb-20">

      {/* Header Area */}
      <div className="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4 shrink-0">
        <div>
          <h1 className="text-3xl font-black tracking-tighter text-zinc-100 flex items-center gap-3">
            Command & Control
          </h1>
          <p className="text-sm text-zinc-500">Execute distributed playbook actions and access remote shells.</p>
        </div>
      </div>

      <div className="flex flex-col lg:flex-row gap-6 h-full min-h-0">

        {/* Scripts Library Sidebar */}
        <div className={cn(
          "w-full lg:w-80 shrink-0 flex flex-col gap-4",
          isFullscreen ? "hidden" : "flex"
        )}>
          {/* Library Header */}
          <div className="rounded-xl bg-zinc-900/40 backdrop-blur-xl border border-white/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] p-4 shadow-sm">
             <div className="flex items-center justify-between mb-4">
               <h2 className="text-sm font-bold text-zinc-100 uppercase tracking-wider flex items-center gap-2">
                 <FolderGit2 className="h-4 w-4" /> Script Library
               </h2>
               <button
                 onClick={() => setIsCreateModalOpen(true)}
                 className="p-1.5 rounded bg-sky-500/10 text-sky-400 hover:bg-sky-500/20 transition-colors border border-sky-500/20"
               >
                 <Plus className="h-4 w-4" />
               </button>
             </div>
             <div className="relative">
                <Search className="absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-zinc-500" />
                <input
                  type="text"
                  placeholder="Search scripts..."
                  className="w-full rounded bg-zinc-950 border border-white/5 py-1.5 pl-9 pr-3 text-xs text-zinc-200 outline-none focus:border-sky-500/50"
                />
             </div>
          </div>

          {/* Script List */}
          <div className="flex-1 rounded-xl bg-zinc-900/40 backdrop-blur-xl border border-white/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] overflow-hidden flex flex-col shadow-sm">
             <div className="flex-1 overflow-y-auto p-2 space-y-1">
                {scripts.length === 0 && (
                  <div className="text-center p-4 text-zinc-500 text-xs font-mono">No scripts found.</div>
                )}
                {scripts.map(script => (
                  <div
                    key={script.script_id}
                    onClick={() => setSelectedScript(script)}
                    className={cn(
                      "flex items-center justify-between p-3 rounded-lg cursor-pointer transition-all duration-200 group border",
                      selectedScript?.script_id === script.script_id
                        ? "bg-sky-500/10 border-sky-500/30 shadow-[inset_0_1px_0_rgba(14,165,233,0.1)]"
                        : "bg-transparent border-transparent hover:bg-white/[0.02] hover:border-white/5"
                    )}
                  >
                    <div className="flex items-start gap-3 overflow-hidden">
                      <FileCode2 className={cn("h-4 w-4 mt-0.5 shrink-0", selectedScript?.script_id === script.script_id ? "text-sky-400" : "text-zinc-500")} />
                      <div className="truncate">
                        <div className={cn("text-sm font-bold truncate", selectedScript?.script_id === script.script_id ? "text-sky-400" : "text-zinc-300")}>
                          {script.name}
                        </div>
                        <div className="text-[10px] font-mono text-zinc-500 flex gap-2 items-center mt-1">
                          <span className="uppercase text-sky-500/70">{script.interpreter}</span>
                        </div>
                      </div>
                    </div>
                    <div className="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <button
                        onClick={(e) => handleDeleteScript(script.script_id, e)}
                        className="p-1.5 rounded hover:bg-rose-500/10 text-zinc-500 hover:text-rose-400"
                        title="Delete"
                      >
                        <Trash2 className="h-3.5 w-3.5" />
                      </button>
                    </div>
                  </div>
                ))}
             </div>
          </div>
        </div>

        {/* Main Terminal Area */}
        <div className="flex-1 rounded-xl bg-[#0a0a0c] border border-white/10 shadow-[0_0_30px_rgba(0,0,0,0.5)] overflow-hidden flex flex-col font-mono relative">

          <div className="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]" />

          <div className="relative flex-1 flex flex-col z-10">
            {/* Terminal Header */}
            <div className="h-[45px] bg-zinc-900/80 backdrop-blur-md border-b border-white/5 flex items-center justify-between px-4 absolute top-0 left-0 right-0 z-20">
              <div className="flex items-center gap-4">
                <TerminalSquare className="h-4 w-4 text-sky-400" />
                <div className="flex items-center gap-2 text-xs font-bold text-zinc-400">
                  <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_5px_rgba(16,185,129,0.5)]" />
                  <span>P2P Link: <span className="text-emerald-500 font-bold">{wsRef.current?.readyState === WebSocket.OPEN ? 'ESTABLISHED' : 'STANDBY'}</span></span>
                </div>

                <div className="relative group flex items-center gap-2">
                  <span className="text-xs text-zinc-600">Target:</span>
                  <input
                    type="text"
                    value={targetDeviceId}
                    onChange={(e) => setTargetDeviceId(e.target.value)}
                    onBlur={(e) => connectWebSocket(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && connectWebSocket(targetDeviceId)}
                    placeholder="Enter Device ID"
                    className="appearance-none bg-zinc-900/40 backdrop-blur-xl border border-white/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] rounded px-3 py-1 text-xs font-bold text-sky-400 focus:outline-none focus:border-sky-500 shadow-inner w-64"
                  />
                  <button onClick={() => connectWebSocket(targetDeviceId)} className="text-[10px] bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-2 py-1 rounded">Connect</button>
                </div>
              </div>

              <div className="flex items-center gap-4">
                {selectedScript && (
                  <button
                    onClick={() => setSelectedScript(null)}
                    className="text-[10px] font-bold text-zinc-400 hover:text-zinc-200 uppercase tracking-wider bg-zinc-800 hover:bg-zinc-700 px-2 py-1 rounded transition-colors"
                  >
                    Close Editor
                  </button>
                )}
                <button
                  onClick={() => setIsFullscreen(!isFullscreen)}
                  className="text-zinc-500 hover:text-zinc-300 p-1 rounded hover:bg-white/5"
                >
                  {isFullscreen ? <Minimize2 className="h-4 w-4" /> : <Maximize2 className="h-4 w-4" />}
                </button>
                <div className="flex gap-2 ml-2">
                  <span className="w-3 h-3 rounded-full bg-rose-500/80 border border-rose-500" />
                  <span className="w-3 h-3 rounded-full bg-amber-500/80 border border-amber-500" />
                  <span className="w-3 h-3 rounded-full bg-emerald-500/80 border border-emerald-500" />
                </div>
              </div>
            </div>

            {/* Viewport Content */}
            <div className="flex-1 mt-[45px] relative">

              {selectedScript ? (
                <div className="absolute inset-0 flex flex-col p-4 animate-in fade-in duration-300 bg-[#0a0a0c]">
                  <div className="flex items-center justify-between mb-4">
                      <span className="text-zinc-300 font-bold text-sm bg-zinc-900 px-3 py-1 rounded-md inline-block border border-white/10">{selectedScript.name}</span>
                      <button
                        onClick={handleRunScriptRest}
                        className="flex items-center gap-2 rounded bg-sky-500/10 border border-sky-500/30 px-4 py-2 text-xs font-bold uppercase tracking-wider text-sky-400 hover:bg-sky-500/20 transition-all shadow-[0_0_10px_rgba(14,165,233,0.1)]"
                      >
                        <Play className="h-4 w-4" /> Run on Target
                      </button>
                  </div>
                  <textarea
                    readOnly
                    value={selectedScript.content}
                    className="flex-1 w-full bg-zinc-900/40 backdrop-blur-xl border border-white/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] rounded-lg p-4 text-emerald-400/90 text-sm shadow-inner outline-none resize-none leading-relaxed"
                  />
                </div>
              ) : (
                <div className="absolute inset-0 flex flex-col p-4 overflow-y-auto space-y-2 text-sm pb-16 scroll-smooth">
                  {terminalHistory.map((entry, idx) => (
                    <div key={idx} className="whitespace-pre-wrap">
                      {entry.type === 'system' && (
                        <span className="text-zinc-500 font-bold">{entry.text}</span>
                      )}
                      {entry.type === 'input' && (
                        <div><span className="text-sky-400">root@{targetDeviceId.substring(0,8)}</span>:<span className="text-blue-400">~</span>$ {entry.text}</div>
                      )}
                      {entry.type === 'output' && (
                        <div className={cn("mt-1", entry.isError ? "text-rose-400" : "text-emerald-400")}>{entry.text}</div>
                      )}
                    </div>
                  ))}
                  <div ref={terminalEndRef} />
                </div>
              )}

              {!selectedScript && (
                <div className="absolute bottom-0 left-0 right-0 bg-[#0a0a0c] p-4 border-t border-white/5">
                  <form onSubmit={handleCommandSubmit} className="flex items-center gap-2 w-full">
                    <span className="text-sky-400 whitespace-nowrap">root@{targetDeviceId.substring(0,8)}:<span className="text-blue-400">~</span>$</span>
                    <input
                      type="text"
                      value={terminalInput}
                      onChange={(e) => setTerminalInput(e.target.value)}
                      className="flex-1 bg-transparent border-none outline-none text-zinc-300 shadow-none"
                      autoFocus
                      autoComplete="off"
                      spellCheck="false"
                    />
                    <span className="animate-pulse w-2 h-4 bg-zinc-500/50 block" />
                  </form>
                </div>
              )}

            </div>
          </div>

        </div>
      </div>

      {/* Create Script Modal Overlay */}
      {isCreateModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-200">
          <div className="w-full max-w-2xl rounded-xl bg-zinc-900/40 backdrop-blur-xl border border-white/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.1),-10px_0_30px_rgba(0,0,0,0.5)] overflow-hidden flex flex-col">
            <div className="flex items-center justify-between border-b border-white/5 p-4 bg-zinc-900/40 backdrop-blur-xl block">
              <h3 className="font-bold text-zinc-100 flex items-center gap-2">
                <Code className="h-5 w-5 text-sky-400" />
                Create Script Template
              </h3>
              <button
                onClick={() => setIsCreateModalOpen(false)}
                className="text-zinc-500 hover:text-zinc-300 transition-colors"
                title="Close"
                type="button"
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            <form onSubmit={handleCreateScript} className="flex flex-col">
              <div className="p-6 space-y-6 bg-transparent">
                <div className="grid grid-cols-2 gap-6">
                  <div>
                    <label className="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-2">Script Name</label>
                    <input
                      type="text"
                      required
                      placeholder="e.g. rotate_logs.sh"
                      value={newScriptForm.name}
                      onChange={(e) => setNewScriptForm(prev => ({...prev, name: e.target.value}))}
                      className="w-full rounded border border-white/10 bg-zinc-900 px-4 py-2 text-sm font-medium text-zinc-200 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-all"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-2">Interpreter Type</label>
                    <select
                      value={newScriptForm.interpreter}
                      onChange={(e) => setNewScriptForm(prev => ({...prev, interpreter: e.target.value}))}
                      className="w-full rounded border border-white/10 bg-zinc-900 px-4 py-2 text-sm font-medium text-zinc-200 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-all"
                    >
                      <option value="bash">Bash Script (.sh)</option>
                      <option value="python">Python 3 (.py)</option>
                      <option value="powershell">PowerShell (.ps1)</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label className="block text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-2">Code Payload</label>
                  <textarea
                    required
                    placeholder="#!/bin/bash"
                    value={newScriptForm.content}
                    onChange={(e) => setNewScriptForm(prev => ({...prev, content: e.target.value}))}
                    className="w-full rounded-lg border border-white/10 bg-[#0a0a0c] p-4 text-sm font-mono text-emerald-400/90 shadow-inner outline-none transition-all focus:border-sky-500 resize-none h-[250px]"
                  />
                </div>
              </div>
              <div className="border-t border-white/5 p-4 bg-zinc-900/40 backdrop-blur-xl flex justify-end gap-3">
                <button
                  type="button"
                  onClick={() => setIsCreateModalOpen(false)}
                  className="rounded px-4 py-2 text-sm font-bold text-zinc-400 hover:text-zinc-200 transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="rounded bg-sky-500 px-6 py-2 text-sm font-bold text-white hover:bg-sky-600 transition-all duration-300 ease-out active:scale-95 shadow-lg shadow-sky-500/20"
                >
                  Save Script
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}
